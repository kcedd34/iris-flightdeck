/// The schema metadata keyed by exported id. Cached per process.
ClassMethod All() As %DynamicObject
{
	if $isobject($get(%FlightDeckSchemas)) quit %FlightDeckSchemas
	set xdata = ##class(%Dictionary.CompiledXData).%OpenId($classname()_"||Schemas")
	set %FlightDeckSchemas = ##class(%DynamicAbstractObject).%FromJSON(xdata.Data)
	quit %FlightDeckSchemas
}

/// Field names of one schema, in specification order, as a $list.
ClassMethod FieldNames(schema As %String) As %List
{
	set names = "", def = ..All().%Get(schema)
	quit:'$isobject(def) ""
	set iter = def.fields.%GetIterator()
	while iter.%GetNext(, .field) { set names = names _ $listbuild(field.name) }
	quit names
}

}
