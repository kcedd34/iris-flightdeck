# Copy to deploy/vm/.env ON THE VM ONLY, with real values. Never committed: .gitignore covers .env*.
# The published demo credential is public by design; the _SYSTEM password is not, and must exist
# nowhere but this file on that machine.
FD_DEMO_USER="demo"
FD_DEMO_PASSWORD=""
# The reduced account, published the same way. Its privileges are fixed in provision.sh (%Operator),
# not here: this file only names it and gives it a password.
FD_DEMO_REDUCED_USER="demo_reduced"
FD_DEMO_REDUCED_PASSWORD=""
FD_DEMO_RESET="every hour"
FD_SYSTEM_PASSWORD=""
