            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityDetailResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domains/{domain}/{entityType}/links": {
      "get": {
        "operationId": "getEntityLinks",
        "summary": "Incoming and outgoing links composed from official reads",
        "parameters": [
          {
            "name": "X-FlightDeck-Tab",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain",
