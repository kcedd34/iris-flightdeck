{
  "openapi": "3.0.3",
  "info": {
    "title": "FlightDeck API additions for feature 002",
    "version": "1.1.0",
    "description": "Merged into the served FlightDeck OpenAPI document (feature 001 contract) during implementation; the served document stays the single source (research R3). Every request carries X-FlightDeck-Tab. Mutating routes are guarded by the feature 001 safe-mode guard; POST /v1/mutations/preview and POST /v1/rest/execute are allow-listed, and execute applies the guard to the method under test (research R8)."
  },
  "paths": {
    "/v1/domains/{domain}/{entityType}": {
      "get": {
        "operationId": "listEntities",
        "summary": "List entities of a descriptor-backed entity type through its official list operation",
        "parameters": [
          {
            "name": "X-FlightDeck-Tab",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "domain",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": ""
          },
          {
            "name": "maxRows",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": ""
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntityListResponse"
                }
              }
            }
          },
          "403": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          },
          "501": {
            "description": "Error envelope from feature 001",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "flightdeck-api.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/domains/{domain}/{entityType}/item": {
