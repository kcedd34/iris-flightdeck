{
  "openapi": "3.0.3",
  "info": {
    "title": "FlightDeck API",
    "version": "1.0.0",
    "description": "Composition layer in front of the official SysAdmin API (/api/admin/v2), plus native providers for gaps named in the constitution (host CPU/memory in this slice). Every call runs in-process under the authenticated IRIS user. FlightDeck stores no credential. Feature 001 slice: session, capabilities, vitals, palette entity search. Served at GET /api/flightdeck/v1/openapi.json; a unit test keeps this document and the router UrlMap in exact parity."
  },
  "servers": [
    {
      "url": "/api/flightdeck/v1"
    }
  ],
  "security": [
    {
      "irisSession": []
    }
  ],
  "components": {
    "securitySchemes": {
      "irisSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "CSPSESSIONID",
        "description": "IRIS-owned CSP session cookie. Set by IRIS after POST /session with HTTP Basic; FlightDeck never reads or writes it."
      },
      "basicOnce": {
        "type": "http",
        "scheme": "basic",
        "description": "Only on POST /session. The client sends it once and discards it."
      }
    },
    "parameters": {
      "TabId": {
        "name": "X-FlightDeck-Tab",
        "in": "header",
        "required": true,
        "description": "Per-tab random id held in memory. Missing -> 400.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "SafeMode": {
        "name": "X-FlightDeck-Safe-Mode",
        "in": "header",
        "required": true,
        "description": "Tab safe-mode state. Any POST/PUT/PATCH/DELETE other than POST/DELETE /session is rejected with 403 SAFE_MODE_ON unless the value is exactly 'disarmed'.",
        "schema": {
          "type": "string",
          "enum": [
            "armed",
            "disarmed"
          ]
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "No valid IRIS session. The client treats a 401 after a previously successful call as session expiry.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error": {
        "description": "Error envelope. IRIS error text is passed through verbatim in 'raw'.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHORIZED",
                  "INVALID_CREDENTIALS",
                  "SAFE_MODE_ON",
                  "MISSING_TAB_ID",
                  "UNSUPPORTED_VERSION",
                  "NO_ADMIN_PRIVILEGE",
                  "UPSTREAM_ERROR",
                  "BAD_REQUEST"
                ]
              },
              "message": {
                "type": "string",
                "description": "English, docs/prd.md section 9 wording where one applies."
              },
              "raw": {
                "type": "string",
                "nullable": true,
                "description": "Original IRIS error text, never rewritten. Never contains credentials."
              },
              "requires": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Missing privileges, e.g. %Admin_Secure:U"
              },
              "detectedVersion": {
                "type": "string",
                "nullable": true
              }
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "username",
          "instance",
          "authPath",
          "privileges",
          "capabilitySummary"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "instance": {
            "type": "object",
            "required": [
              "product",
              "version",
              "serverVersion",
              "apiVersion",
              "namespace",
              "dialect"
            ],
            "properties": {
              "product": {
                "type": "string",
                "example": "iris"
              },
              "version": {
                "type": "string",
                "example": "2026.2",
                "description": "Display only."
              },
              "serverVersion": {
                "type": "string"
              },
              "apiVersion": {
                "type": "number",
                "example": 2,
                "description": "Diagnostic only, as reported by the instance's /info. Clients MUST NOT decide anything from it."
              },
              "namespace": {
                "type": "string",
                "example": "USER"
              },
              "edition": {
                "type": "string",
                "nullable": true,
                "example": "Community",
                "description": "'Community' when the license platform is a Community edition; empty when not, or when the user cannot read license information (requires %Admin_Manage:U). The license key is never returned."
              },
              "dialect": {
                "type": "string",
                "enum": [
                  "v2",
                  "v1"
                ],
                "description": "Diagnostic only: the SysAdmin API dialect selected once per session ('v1' is IRIS 2026.1). Clients MUST NOT decide anything from it; operation availability comes from CapabilityEntry.available (FR-012a). An instance without any SysAdmin API is refused at sign-in."
              }
            }
          },
          "authPath": {
            "type": "string",
            "enum": [
              "in_process"
            ]
          },
          "privileges": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "use": {
                  "type": "boolean"
                }
              }
            },
            "example": {
              "%Admin_Secure": {
                "use": true
              }
            }
          },
          "capabilitySummary": {
            "type": "object",
            "properties": {
              "allowed": {
                "type": "integer",
                "description": "Operations the user holds the declared privilege for and the instance offers."
              },
              "unavailable": {
                "type": "integer",
                "description": "Operations the instance does not offer (CapabilityEntry.available false). Limited mode is shown while this is above 0."
              },
              "total": {
                "type": "integer",
                "example": 273
              }
            }
          }
        }
      },
      "CapabilityEntry": {
        "type": "object",
        "required": [
          "operationId",
          "method",
          "path",
          "domain",
          "mutating",
          "summary",
          "requires",
          "allowed",
          "available",
          "reason"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "example": "DELETE /v2/security/role"
          },
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "PUT",
              "POST",
              "DELETE"
            ]
          },
          "path": {
            "type": "string"
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "mutating": {
            "type": "boolean"
          },
          "summary": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allowed": {
            "type": "boolean",
            "description": "The user holds a privilege the v2 specification declares for the operation."
          },
          "available": {
            "type": "boolean",
            "description": "The instance offers the operation (always true on v2; on v1, true when a v1 route exists). Privileges always come from the v2 specification."
          },
          "reason": {
            "type": "string",
            "nullable": true,
            "description": "Version message when unavailable, otherwise the privilege message when not allowed, otherwise null."
          }
        }
      },
      "Domain": {
        "type": "string",
        "enum": [
          "shell",
          "web-apps",
          "permissions",
          "security",
          "tasks",
          "system",
          "logs"
        ]
      },
      "Vital": {
        "type": "object",
        "required": [
          "id",
          "label",
          "source",
          "scope",
          "state",
          "value",
          "asOf",
          "pending",
          "reason",
          "requires"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "shm",
              "disk"
            ]
          },
          "label": {
            "type": "string",
            "enum": [
              "CPU",
              "Memory",
              "Shared memory",
              "Disk"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "native",
              "api"
            ],
            "description": "native = FlightDeck.Native.HostMetrics (/proc), api = SysAdmin API"
          },
          "scope": {
            "type": "string",
            "nullable": true,
            "example": "Docker host kernel"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "caution",
              "warning",
              "unavailable"
            ]
          },
          "value": {
            "type": "number",
            "nullable": true
          },
          "asOf": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pending": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "requires": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EntityEntry": {
        "type": "object",
        "required": [
          "kind",
          "domain",
          "entityType",
          "name",
          "context",
          "sourceOperationId",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "entity"
            ]
          },
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "entityType": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "sourceOperationId": {
            "type": "string"
          },
          "target": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string",
                "example": "/permissions/roles"
              },
              "inspect": {
                "type": "object",
                "properties": {
                  "entityType": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "EntitySearchGroup": {
        "type": "object",
        "required": [
          "domain",
          "entityType",
          "state",
          "reason",
          "results",
          "total"
        ],
        "properties": {
          "domain": {
            "$ref": "#/components/schemas/Domain"
          },
          "entityType": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "forbidden",
              "timeout",
              "error",
              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "nullable": true
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntityEntry"
            }
          },
          "total": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/session": {
      "post": {
        "summary": "Sign in. IRIS authenticates the Basic header before dispatch and opens its own session.",
        "security": [
          {
            "basicOnce": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          }
        ],
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "description": "INVALID_CREDENTIALS: 'Invalid credentials. Check your username and password.' Same response for unknown user and wrong password.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "NO_ADMIN_PRIVILEGE (user holds no %Admin_* privilege; requires listed) or UNSUPPORTED_VERSION (apiVersion < 2; detectedVersion set). The IRIS session is ended before responding.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Current session, derived fresh from /info.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          }
        ],
        "responses": {
          "200": {
            "description": "Active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "summary": "Sign out. Ends the IRIS session.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          }
        ],
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/session/capabilities": {
      "get": {
        "summary": "Capability map derived from the official spec's declared privileges crossed with /info privileges. 273 entries.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "entries": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CapabilityEntry"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/vitals": {
      "get": {
        "summary": "Glareshield vitals snapshot: host CPU and memory (native provider, requires Use on %Admin_Operate), IRIS shared memory and disk (SysAdmin API). Disk is async: returns last known value with pending=true while a refresh task runs.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "vitals": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Vital"
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/palette/entities": {
      "get": {
        "summary": "Generic entity search across every domain's list operations. Never fails as a whole: partial results with degraded=true.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TabId"
          },
          {
            "$ref": "#/components/parameters/SafeMode"
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Domain"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK (possibly degraded)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "groups",
                    "degraded",
                    "reason",
                    "totalResults"
                  ],
                  "properties": {
                    "groups": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/EntitySearchGroup"
                      }
                    },
                    "degraded": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "nullable": true
                    },
                    "totalResults": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document. Requires an IRIS session like every other route (the web application uses Password authentication); only the X-FlightDeck-Tab header is optional.",
        "responses": {
          "200": {
            "description": "OpenAPI 3.0.3 document"
          }
        }
      }
    }
  }
}
